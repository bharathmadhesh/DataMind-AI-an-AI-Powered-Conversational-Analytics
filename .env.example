# Data Q&A Environment Configuration

# Groq API Configuration (Free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Local instance: https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Default active provider ("Groq" or "Ollama")
DEFAULT_PROVIDER=Groq
